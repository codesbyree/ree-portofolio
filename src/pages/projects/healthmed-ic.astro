---
import Layout from "@/layouts/Layout.astro";
import HoverScrambleText from "@/components/animation/hover-scramble-text.astro";
---

<Layout title="Project PT Sari Alam HR and Attendance System">
    <main class="bg-[#FAFAFA]">
        <div class="w-full max-w-[1680px] py-21.5 xl:py-25">
            <div class="flex flex-col gap-16 xl:gap-4 xl:grid xl:grid-cols-16">
                <aside class="xl:col-span-5">
                    <a href="/">Back</a>
                </aside>

                <section class="xl:col-span-9 col-start-8">
                    <h1>Project title here</h1>
                </section>
            </div>
        </div>
    </main>

    <HoverScrambleText />
</Layout>
