---
import { cn } from "@/libs/utils";
import { type HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class={cn(
    "inline-flex items-center gap-1 text-blue-600 underline-offset-4 hover:underline hover:text-blue-700 transition-colors",
    className
  )}
  {...rest}
>
  <slot />
</a>
