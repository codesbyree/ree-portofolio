---
import { Image } from "astro:assets";

import heroTreesImage from "@/assets/images/hero-image.png";
import arrowPatternImage from "@/assets/images/arrow-pattern.svg";
import heroNameImage from "@/assets/images/hero-name.svg";
import cloud1Image from "@/assets/images/cloud-1.png";
import cloud2Image from "@/assets/images/cloud-2.png";
import arrowDownImage from "@/assets/images/arrow-down.svg";
---

<section id="hero-section" class="bg-linear-to-b from-[#0A66AC] to-[#21AFF3] bg-fixed overflow-hidden">
    <div class="h-dvh w-full max-h-192 xl:max-h-262.5 relative flex">
        <div class="2xl:max-w-360 2xl:px-0 mx-auto w-full pb-4 px-4 md:px-6 xl:px-12.5 relative flex-1 flex flex-col">
            <div class="flex flex-col xl:grid grid-cols-12 gap-6 md:gap-12 xl:gap-4 relative flex-1 pt-27.5 z-20">
                <div id="hero-arrow" class="col-span-3 pt-3 opacity-100 xl:opacity-0 max-w-45 md:max-w-70 xl:max-w-full">
                    <Image src={arrowPatternImage} alt="arrow pattern" aria-hidden="true" />
                </div>

                <div id="hero-text_container" class="col-span-7 col-start-6 opacity-100 xl:opacity-0 space-y-8">
                    <h1 id="hero-text" class="text-white font-medium text-3xl leading-10 tracking-tight">
                        <span class="hidden md:inline">I am Saepul Bahri, a Frontend Developer crafting high-performance, digital experiences.</span> I turn ideas into clean, accessible, and highly
                        optimized web platforms.
                    </h1>

                    <a class="text-white font-medium text-xl md:text-3xl leading-10 tracking-tight flex items-center gap-6 md:gap-10 h-max">
                        <span>Scroll down</span>
                        <Image src={arrowDownImage} alt="" class="w-auto h-5 md:h-7" />
                    </a>
                </div>

                <div id="hero_nameImage" class="hidden xl:block absolute bottom-0 opacity-0 left-1/2 -translate-x-1/2 w-full will-change-transform pointer-events-none">
                    <div id="hero-name-target" class="w-full mt-[calc(35%-16px)] 2xl:mt-[calc(25%-16px)]">
                        <Image src={heroNameImage} alt="hero name" class="w-full h-auto" />
                    </div>
                </div>
            </div>

            <div class="clouds hidden xl:block absolute left-0 top-[15%] w-99.5 z-30 opacity-0">
                <div id="cloud-left" class="w-full">
                    <Image src={cloud1Image} alt="cloud decorative" aria-hidden="true" class="w-full h-auto" />
                </div>
            </div>

            <div class="clouds hidden xl:block absolute right-0 top-[23%] w-115 z-10 opacity-0">
                <div id="cloud-right" class="w-full">
                    <Image src={cloud2Image} alt="cloud decorative" aria-hidden="true" class="w-full h-auto" />
                </div>
            </div>
        </div>

        <div id="hero-tree" class="w-dvw overflow-hidden z-30 bottom-0 xl:translate-y-full absolute h-max">
            <div class="flex justify-center">
                <div class="h-75 w-[1837px] xl:h-103 xl:w-[2522px] shrink-0 relative">
                    <Image src={heroTreesImage} alt="" class="absolute top-0 left-0 w-full h-full object-contain" />
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, SplitText } from "@/libs/gsap";

    function initAnimation() {
        const sectionContainer = document.querySelector("#hero-section");
        const heroNameImage = document.querySelector("#hero_nameImage");
        const heroNameTarget = document.querySelector("#hero-name-target");
        const heroText = document.querySelector("#hero-text");
        const heroArrow = document.querySelector("#hero-arrow");
        const heroTextContainer = document.querySelector("#hero-text_container");
        const heroTree = document.querySelector("#hero-tree");
        const cloudLeft = document.querySelector("#cloud-left");
        const cloudRight = document.querySelector("#cloud-right");

        const mm = gsap.matchMedia();

        mm.add("(min-width: 1280px)", () => {
            const split = new SplitText(heroText, {
                type: "lines,words",
                linesClass: "overflow-hidden",
            });

            const scrollTl = gsap.timeline({
                scrollTrigger: {
                    trigger: sectionContainer,
                    start: "top top",
                    end: "+=410px",
                    pin: true,
                    scrub: true,
                    anticipatePin: 1,
                    invalidateOnRefresh: true,
                },
            });

            scrollTl
                .to(heroTree, { yPercent: -80, ease: "none" }, 0)
                .to(cloudLeft, { y: -80, ease: "none" }, 0)
                .to(cloudRight, { y: -120, ease: "none" }, 0)
                .to(heroNameTarget, { y: -40, ease: "none" }, 0);

            const introTl = gsap.timeline({
                delay: 0.5,
                defaults: {
                    ease: "power3.out",
                },
            });

            introTl
                .fromTo(
                    ".clouds",
                    {
                        y: 50,
                        filter: "blur(24px)",
                        opacity: 0,
                    },
                    {
                        y: 0,
                        duration: 0.8,
                        filter: "blur(0px)",
                        opacity: 1,
                        stagger: 0.3,
                    },
                )
                .fromTo(
                    heroNameImage,
                    {
                        scale: 0.1,
                        y: -100,
                        filter: "blur(24px)",
                        opacity: 0,
                    },
                    {
                        scale: 1,
                        y: 0,
                        duration: 0.8,
                        filter: "blur(0px)",
                        opacity: 1,
                    },
                    0.3,
                )
                .fromTo(heroTextContainer, { opacity: 0 }, { opacity: 1 }, 0.2)
                .fromTo(
                    split.words,
                    {
                        y: 20,
                        opacity: 0,
                        filter: "blur(4px)",
                    },
                    {
                        y: 0,
                        opacity: 1,
                        filter: "blur(0px)",
                        duration: 0.5,
                        stagger: 0.05,
                    },
                    0.2,
                )
                .fromTo(
                    heroArrow,
                    {
                        opacity: 0,
                        filter: "blur(4px)",
                        x: 50,
                    },
                    {
                        opacity: 1,
                        filter: "blur(0px)",
                        x: 0,
                    },
                    0.1,
                );
        });
    }

    initAnimation();
</script>
