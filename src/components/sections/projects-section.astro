---
import { Image } from "astro:assets";

import ProjectCard from "../ui/project-card.astro";

import project1Image from "@/assets/images/project-1.jpg";
import project2Image from "@/assets/images/project-2.jpg";
import project3Image from "@/assets/images/project-3.jpg";
import project4Image from "@/assets/images/project-4.jpg";
import project5Image from "@/assets/images/project-5.jpg";
import projectSectionPatternImage from "@/assets/images/project-section-pattern.png";
---

<section id="project-section" class="bg-[#FAFAFA] py-21.5 xl:py-25">
    <div class="2xl:max-w-[1680px] px-4 md:px-6 xl:px-6 mx-auto w-full flex flex-col gap-16 relative">
        <div class="flex flex-col xl:grid xl:grid-cols-16 gap-5 relative z-10">
            <div class="col-span-7">
                <span data-hover-scramble data-original-text="Projects" data-target-text="Projects" class="font-pixels text-xl text-gray-400 tracking-tight font-medium">
                    Projects
                </span>
            </div>

            <div class="col-span-9 col-start-8 row-start-1 space-y-4">
                <h2 id="project-title" class="text-2xl md:text-3xl xl:text-4xl leading-9 md:leading-11 xl:leading-14 tracking-tight font-medium text-blue-950">
                    A collection of projects spanning paid client work, an academic capstone, and independent coding practice.
                </h2>
                <p id="project-subtitle" class="text-gray-500 text-lg xl:text-xl leading-7 xl:leading-7.5 tracking-tight">
                    These projects span paid client engagements, an academic capstone project, and a self-directed coding challenge, each approached with the same care. Together they show a developer
                    comfortable moving from static websites to full-scale, custom-built systems.
                </p>
            </div>
        </div>

        <div
            id="project-card_container"
            class="flex flex-col gap-6 md:grid md:grid-cols-12 xl:grid-cols-16 grid-rows-[repeat(2,max-content)] col-span-full md:gap-4 md:gap-y-6 xl:gap-y-8 relative z-10"
        >
            <ProjectCard
                href="/projects/sari-alam"
                imageContainerClass="xl:pt-[calc((394/515)*100%)]"
                imageClass="object-contain object-bottom"
                class="md:col-start-1 md:col-span-6 xl:col-span-7"
                title="Employee Management and Attendance Suite"
                description="PT Sari Alam Sukabumi"
                image={project1Image}
                year={2026}
            />

            <ProjectCard
                href="/projects/healthmed-ic"
                class="col-start-7 xl:col-start-8 md:col-span-6 xl:col-span-3"
                title="HEALTHMED-IC 2026"
                description="Institut  Guna Bangsa"
                image={project2Image}
                year={2026}
            />

            <ProjectCard
                href="/projects/compgineer-2026"
                class="md:row-start-2 xl:row-start-1 md:col-start-5 xl:col-start-14 md:col-span-4 xl:col-span-3"
                title="Compgineer 2026"
                description="Nusa Putra Global"
                image={project3Image}
                year={2026}
            />

            <ProjectCard href="/projects/carepoint" class="row-start-2 md:col-start-1 md:col-span-4 xl:col-span-3" title="Carepoint" description="-" image={project4Image} year={2026} />

            <ProjectCard
                href="/projects/fxchecker"
                class="row-start-2 md:col-start-9 md:col-span-4 xl:col-start-8 xl:col-span-3"
                title="Forex Checker"
                description="Frontendmentor"
                image={project5Image}
                year={2026}
            />
        </div>

        <Image src={projectSectionPatternImage} alt="" class="absolute top-0 -left-30 h-full w-auto" />
    </div>
</section>

<script>
    import { gsap, SplitText } from "@/libs/gsap";

    function initAnimation() {
        const sectionContainer = document.querySelector("#project-section");
        const sectionTitle = document.querySelector("#project-title");
        const projectSubtitle = document.querySelector("#project-subtitle");
        const projectCardContainer = document.querySelector("#project-card_container");

        const mm = gsap.matchMedia();
        mm.add("(min-width:1280px)", () => {
            const sectionTitleSplit = new SplitText(sectionTitle, {
                type: "lines",
                linesClass: "overflow-hidden",
            });

            const tl = gsap.timeline({
                defaults: {
                    duration: 0.5,
                    ease: "power3.out(1.5)",
                },
                scrollTrigger: {
                    trigger: sectionContainer,
                    start: "top 70%",
                    toggleActions: "play none none none",
                },
            });

            const projectCardTl = gsap.timeline({
                defaults: {
                    duration: 0.5,
                    ease: "power3.out(1.5)",
                },
                scrollTrigger: {
                    trigger: projectCardContainer,
                    start: "top 70%",
                    toggleActions: "play none none none",
                },
            });

            projectCardTl.from(".project-card", {
                y: 20,
                opacity: 0,
                filter: "blur(12px)",
                stagger: 0.1,
            });

            tl.from(sectionTitleSplit.lines, {
                y: 20,
                opacity: 0,
                filter: "blur(12px)",
                stagger: 0.1,
            }).from(
                projectSubtitle,
                {
                    y: 20,
                    opacity: 0,
                },
                0.3,
            );
        });
    }

    initAnimation();
</script>
